<?xml version="1.0"?>
<robot name="wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheels -->
  <property name="diam_wheel"      value="0.11050" /> <!-- Diameter of wheel  -->
  <property name="thickness_wheel" value="0.04520" /> <!-- Thickness of wheel -->
  <property name="mass_wheel"      value="0.34055" /> <!-- Mass of wheel      -->
  
  <property name="base_x_origin_to_wheel_origin" value="0.1700" />
  <property name="base_y_origin_to_wheel_origin" value="0.1215" />
  <!-- Use 0 for initial condition, else based on the springs, the distance is 1in higher -->
  <property name="base_z_origin_to_wheel_origin" value="0.0280" />


  <!-- Hinges -->
  <property name="diam_hinge"      value="0.1105" /> <!-- Diameter of wheel  -->
  <property name="thickness_hinge" value="0.0452" /> <!-- Thickness of wheel -->
  <property name="mass_hinge"      value="0.1000" /> <!-- Mass of wheel      -->
  
  <property name="base_x_origin_to_hinge_origin" value="0.170" />
  <property name="base_y_origin_to_hinge_origin" value="0.105" />
  <property name="base_z_origin_to_hinge_origin" value="0.028" />

  <!-- Inertias -->
  
  <macro name="cylinder_inertia" params="m r h">
    <inertia  ixx="${m*(3*r*r+h*h)/12}" ixy = "0" ixz = "0"
              iyy="${m*(3*r*r+h*h)/12}" iyz = "0"
              izz="${m*r*r/2}" /> 
  </macro>



  <!-- First xacro macro -->
  
  <xacro:macro name="wheels" params="rf lr parent translateX translateY translateZ flipX flipY"> <!--rf: rear, front; lr: left, right -->
    <link name="${rf}_${lr}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${flipX*Pi/2} ${flipY*Pi/2} 0 " /> 
        <geometry>
          <!-- cylinder length="${thickness_wheel}" radius="${diam_wheel/2}" /-->
          <mesh filename="package://tc_description/meshes/collada/wheel.dae" scale="0.1 0.1 0.1" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${flipX*Pi/2} ${flipY*Pi/2} 0 " />
        <geometry>
          <!-- cylinder length="${thickness_wheel}" radius="${diam_wheel/2}" /-->
          <mesh filename="package://tc_description/meshes/collada/wheel.dae" scale="0.1 0.1 0.1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_wheel}" />
        <origin xyz="0 0 0" />
        <cylinder_inertia  m="${mass_wheel}" r="${diam_wheel/2}" h="${thickness_wheel}" />
      </inertial>
    </link>

    <gazebo reference="${rf}_${lr}_wheel">
      <mu1 value="1.0"/>
      <mu2 value="1.0"/>
      <kp  value="10000000.0" />
      <kd  value="1.0" />
      <fdir1 value="1 0 0"/>
      <material>Gazebo/Black</material>
      <turnGravityOff>false</turnGravityOff>
    </gazebo>

    <joint name="${rf}_${lr}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${rf}_${lr}_wheel"/>
      <origin xyz="${translateX * base_x_origin_to_wheel_origin} ${translateY * base_y_origin_to_wheel_origin} ${translateZ * base_z_origin_to_wheel_origin}" rpy="0 0 0" /> 
      <axis xyz="0 1 0" rpy="0  0" />
      <limit effort="100" velocity="100"/>
      <joint_properties damping="0.0" friction="0.0"/>
    </joint>

    <!-- Transmission is important to link the joints and the controller -->
    <transmission name="${rf}_${lr}_wheel_trans" type="SimpleTransmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${rf}_${lr}_wheel_joint">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${rf}_${lr}_wheel_motor">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
   
  </xacro:macro>


    <!-- Second xacro macro -->


  <xacro:macro name="hinges" params="lr parent translateX translateY translateZ flipY"> <!--lr: left, right -->
    <link name="${lr}_hinge">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0 " /> 
        <geometry>
          
          <mesh filename="package://tc_description/meshes/stl/hinge.stl" scale="1 1 1" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0 " />
        <geometry>
          
          <mesh filename="package://tc_description/meshes/stl/hinge.stl" scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_hinge}" />
        <origin xyz="0 0 0" />
        <cylinder_inertia  m="${mass_hinge}" r="${diam_hinge/2}" h="${thickness_hinge}" />
      </inertial>
    </link>

    <gazebo reference="${lr}_hinge">
      <mu1 value="1.0"/>
      <mu2 value="1.0"/>
      <kp  value="10000000.0" />
      <kd  value="1.0" />
      <fdir1 value="1 0 0"/>
      <material>Gazebo/Black</material>
      <turnGravityOff>false</turnGravityOff>
    </gazebo>

    <joint name="${lr}_hinge_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${lr}_hinge"/>
      <origin xyz="${translateX * base_x_origin_to_hinge_origin} ${translateY * base_y_origin_to_hinge_origin} ${translateZ * base_z_origin_to_hinge_origin}" rpy="0 0 0" /> 
      <axis xyz="-1 0 0" rpy="0  0" />
      <limit lower="-1.0" upper="1.0" effort="10" velocity="100"/>
      <joint_properties damping="0.0" friction="0.0"/>
    </joint>

    <!-- Transmission is important to link the joints and the controller -->
    <transmission name="${lr}_hinge_trans" type="SimpleTransmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${lr}_hinge_joint">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${lr}_hinge_motor">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
   
  </xacro:macro>




  <!-- Third xacro macro -->


  <xacro:macro name="hinge_wheels" params="rf lr parent translateX translateY translateZ flipX flipY"> <!--lr: left, right -->
    <link name="${rf}_${lr}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${flipX*Pi/2} ${flipY*Pi/2} 0 " /> 
        <geometry>
          <!-- cylinder length="${thickness_wheel}" radius="${diam_wheel/2}" /-->
          <mesh filename="package://tc_description/meshes/collada/wheel.dae" scale="0.1 0.1 0.1" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${flipX*Pi/2} ${flipY*Pi/2} 0 " />
        <geometry>
          <!-- cylinder length="${thickness_wheel}" radius="${diam_wheel/2}" /-->
          <mesh filename="package://tc_description/meshes/collada/wheel.dae" scale="0.1 0.1 0.1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_wheel}" />
        <origin xyz="0 0 0" />
        <cylinder_inertia  m="${mass_wheel}" r="${diam_wheel/2}" h="${thickness_wheel}" />
      </inertial>
    </link>

    <gazebo reference="${rf}_${lr}_wheel">
      <mu1 value="1.0"/>
      <mu2 value="1.0"/>
      <kp  value="10000000.0" />
      <kd  value="1.0" />
      <fdir1 value="1 0 0"/>
      <material>Gazebo/Black</material>
      <turnGravityOff>false</turnGravityOff>
    </gazebo>

    <joint name="${rf}_${lr}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${rf}_${lr}_wheel"/>
      <origin xyz="${translateX * (base_x_origin_to_hinge_origin - base_x_origin_to_wheel_origin)} ${translateY * ((thickness_wheel/2) + base_y_origin_to_hinge_origin - base_y_origin_to_wheel_origin)} ${translateZ * (base_z_origin_to_hinge_origin - base_z_origin_to_wheel_origin)}" rpy="0 0 0" /> 
      <axis xyz="0 1 0" rpy="0  0" />
      <limit effort="100" velocity="100"/>
      <joint_properties damping="0.0" friction="0.0"/>
    </joint>

    <!-- Transmission is important to link the joints and the controller -->
    <transmission name="${rf}_${lr}_wheel_trans" type="SimpleTransmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${rf}_${lr}_wheel_joint">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${rf}_${lr}_wheel_motor">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
   
  </xacro:macro>




</robot>
