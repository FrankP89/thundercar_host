<?xml version="1.0"?>
<robot name="thundercar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Mobile Thundercar model for Gazebo Harmonic (no world fixed joint) -->
  <!-- Use xacro built-in pi (do not redefine — causes "redefining global symbol: pi") -->

  <xacro:property name="mass_body" value="3.00"/>
  <xacro:property name="length_body" value="0.50"/>
  <xacro:property name="width_body" value="0.30"/>
  <xacro:property name="height_body" value="0.08"/>

  <xacro:include filename="$(find tc_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find tc_description)/urdf/wheel.urdf.xacro"/>
  <xacro:include filename="$(find tc_description)/urdf/sick_tim.urdf.xacro"/>
  <xacro:include filename="$(find tc_description)/urdf/tc.gazebo.xacro"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <!-- base_footprint on ground under base_link -->
  <link name="base_footprint">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 -0.0275" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="base_footprint"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://tc_description/meshes/stl/traxxas_base.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="${length_body} ${width_body} 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mass_body}"/>
      <origin xyz="0 0 0.02"/>
      <xacro:box_inertia m="${mass_body}" x="${length_body}" y="${width_body}" z="${height_body}"/>
    </inertial>
  </link>

  <!-- Lower plate -->
  <joint name="low_plate_joint" type="fixed">
    <origin xyz="0 0 0.0885" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="low_plate_link"/>
  </joint>

  <link name="low_plate_link">
    <visual>
      <geometry>
        <mesh filename="package://tc_description/meshes/stl/low_plate.stl" scale="0.1 0.1 0.1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.22 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <xacro:box_inertia m="0.3" x="0.35" y="0.22" z="0.01"/>
    </inertial>
  </link>

  <!-- SICK TIM 571 -->
  <xacro:sick_tim571 name="laser" parent_frame="low_plate_link"/>

  <!-- Jetson (visual) -->
  <joint name="jetson_joint" type="fixed">
    <origin xyz="-0.0645 0.040 0.00814" rpy="0 0 0"/>
    <parent link="low_plate_link"/>
    <child link="jetson_link"/>
  </joint>
  <link name="jetson_link">
    <visual>
      <geometry>
        <mesh filename="package://tc_description/meshes/stl/nano_jetson.stl" scale="0.1 0.1 0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Upper plate -->
  <joint name="up_plate_joint" type="fixed">
    <origin xyz="-0.02 0 0.0814" rpy="0 0 0"/>
    <parent link="low_plate_link"/>
    <child link="up_plate_link"/>
  </joint>
  <link name="up_plate_link">
    <visual>
      <geometry>
        <mesh filename="package://tc_description/meshes/stl/upper_plate.stl" scale="0.1 0.1 0.1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.30 0.20 0.008"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <xacro:box_inertia m="0.2" x="0.30" y="0.20" z="0.008"/>
    </inertial>
  </link>

  <!-- Camera mount (legacy myntai_support name, Orbbec Femto Bolt camera) -->
  <joint name="myntai_support_joint" type="fixed">
    <origin xyz="0.12455 0 0.006" rpy="0 0 0"/>
    <parent link="up_plate_link"/>
    <child link="myntai_support_link"/>
  </joint>
  <link name="myntai_support_link">
    <visual>
      <geometry>
        <mesh filename="package://tc_description/meshes/stl/myntai_support.stl" scale="0.1 0.1 0.1"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.08 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.040 0.0 0.0270" rpy="0 0 0"/>
    <parent link="myntai_support_link"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.039 0.106 0.037"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.039 0.106 0.037"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.270"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Optical frames (ROS optical: Z forward, X right, Y down) -->
  <joint name="camera_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
  </joint>
  <link name="camera_color_optical_frame">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
  </joint>
  <link name="camera_depth_optical_frame">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- Battery -->
  <joint name="battery_joint" type="fixed">
    <origin xyz="0.0 0.0 0.006" rpy="0 0 0"/>
    <parent link="up_plate_link"/>
    <child link="battery_link"/>
  </joint>
  <link name="battery_link">
    <visual>
      <geometry>
        <mesh filename="package://tc_description/meshes/stl/battery.stl" scale="0.1 0.1 0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Wheels + steering -->
  <xacro:wheels rf="back" lr="left" parent="base_link" translateX="-1" translateY="1" translateZ="1"/>
  <xacro:wheels rf="back" lr="right" parent="base_link" translateX="-1" translateY="-1" translateZ="1"/>
  <xacro:hinges lr="left" parent="base_link" translateX="1" translateY="1" translateZ="1"/>
  <xacro:hinges lr="right" parent="base_link" translateX="1" translateY="-1" translateZ="1"/>
  <xacro:hinge_wheels rf="front" lr="left" parent="left_hinge" translateY="1"/>
  <xacro:hinge_wheels rf="front" lr="right" parent="right_hinge" translateY="-1"/>

  <xacro:thundercar_gazebo/>

</robot>
