<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="diam_wheel" value="0.11050"/>
  <xacro:property name="thickness_wheel" value="0.04520"/>
  <xacro:property name="mass_wheel" value="0.34055"/>
  <xacro:property name="base_x_origin_to_wheel_origin" value="0.1700"/>
  <xacro:property name="base_y_origin_to_wheel_origin" value="0.1215"/>
  <xacro:property name="base_z_origin_to_wheel_origin" value="0.0280"/>

  <xacro:property name="mass_hinge" value="0.050"/>
  <xacro:property name="base_x_origin_to_hinge_origin" value="0.170"/>
  <xacro:property name="base_y_origin_to_hinge_origin" value="0.105"/>
  <xacro:property name="base_z_origin_to_hinge_origin" value="0.028"/>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0"
             izz="${m*r*r/2}"/>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <!-- Driven rear wheels -->
  <xacro:macro name="wheels" params="rf lr parent translateX translateY translateZ">
    <link name="${rf}_${lr}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder length="${thickness_wheel}" radius="${diam_wheel/2}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder length="${thickness_wheel}" radius="${diam_wheel/2}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_wheel}"/>
        <origin xyz="0 0 0"/>
        <xacro:cylinder_inertia m="${mass_wheel}" r="${diam_wheel/2}" h="${thickness_wheel}"/>
      </inertial>
    </link>

    <joint name="${rf}_${lr}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${rf}_${lr}_wheel"/>
      <origin xyz="${translateX * base_x_origin_to_wheel_origin} ${translateY * base_y_origin_to_wheel_origin} ${translateZ * base_z_origin_to_wheel_origin}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <gazebo reference="${rf}_${lr}_wheel">
      <!-- Enough grip to resist sideways slide at rest, still driveable -->
      <mu1>12.0</mu1>
      <mu2>8.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxContacts>4</maxContacts>
    </gazebo>
  </xacro:macro>

  <!-- Front steering knuckles -->
  <xacro:macro name="hinges" params="lr parent translateX translateY translateZ">
    <link name="${lr}_hinge">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.04"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_hinge}"/>
        <origin xyz="0 0 0"/>
        <xacro:box_inertia m="${mass_hinge}" x="0.02" y="0.02" z="0.04"/>
      </inertial>
    </link>

    <joint name="${lr}_hinge_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${lr}_hinge"/>
      <origin xyz="${translateX * base_x_origin_to_hinge_origin} ${translateY * base_y_origin_to_hinge_origin} ${translateZ * base_z_origin_to_hinge_origin}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.6" upper="0.6" effort="20" velocity="5"/>
      <dynamics damping="1.0" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- Front wheels attached to hinges -->
  <xacro:macro name="hinge_wheels" params="rf lr parent translateY">
    <link name="${rf}_${lr}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder length="${thickness_wheel}" radius="${diam_wheel/2}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder length="${thickness_wheel}" radius="${diam_wheel/2}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_wheel}"/>
        <origin xyz="0 0 0"/>
        <xacro:cylinder_inertia m="${mass_wheel}" r="${diam_wheel/2}" h="${thickness_wheel}"/>
      </inertial>
    </link>

    <joint name="${rf}_${lr}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${rf}_${lr}_wheel"/>
      <origin xyz="0 ${translateY * 0.0165} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.5" friction="0.05"/>
    </joint>

    <gazebo reference="${rf}_${lr}_wheel">
      <mu1>12.0</mu1>
      <mu2>8.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxContacts>4</maxContacts>
    </gazebo>
  </xacro:macro>

</robot>
