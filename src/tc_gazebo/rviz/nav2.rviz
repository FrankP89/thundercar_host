Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /Path1
      Splitter Ratio: 0.5
    Tree Height: 320
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Color Scheme: map
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Enabled: true
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
      Value: true
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Enabled: true
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.05
      Topic:
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: ParticleCloud
      Enabled: true
      Topic:
        Value: /particlecloud
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /plan
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Name: LocalPlan
      Enabled: true
      Topic:
        Value: /local_plan
      Value: true
    - Class: rviz_default_plugins/Image
      Name: ColorImage
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Navigation 2:
    collapsed: false
