<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tc_indoor">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>80</mu2>
              </ode>
              <bullet>
                <friction>1.0</friction>
                <friction2>0.8</friction2>
                <rolling_friction>0.15</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls: 10x8 m room -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 0.15 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10 0.15 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 0.15 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10 0.15 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 8 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 8 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 8 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 8 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Interior partition with doorway gap -->
    <model name="partition_a">
      <static>true</static>
      <pose>0 2.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 3 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 3 2</size></box></geometry>
          <material><ambient>0.6 0.55 0.5 1</ambient><diffuse>0.7 0.65 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="partition_b">
      <static>true</static>
      <pose>0 -2.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 3 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.12 3 2</size></box></geometry>
          <material><ambient>0.6 0.55 0.5 1</ambient><diffuse>0.7 0.65 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Furniture / landmarks for SLAM -->
    <model name="box_1">
      <static>true</static>
      <pose>3 2.5 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.4 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.4 0.8</size></box></geometry>
          <material><ambient>0.3 0.45 0.7 1</ambient><diffuse>0.35 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-3 -2 0.35 0 0 -0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.7</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.7</size></box></geometry>
          <material><ambient>0.7 0.35 0.3 1</ambient><diffuse>0.8 0.4 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cylinder_1">
      <static>true</static>
      <pose>2.5 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.35 0.65 0.4 1</ambient><diffuse>0.4 0.75 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_3">
      <static>true</static>
      <pose>-2.5 2.2 0.25 0 0 0.1</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.35 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.0 0.35 0.5</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.65 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
